# AI Cover Letter Generator — configuration.
#
# Copy to .env and adjust. Every value below is a default baked into the binary;
# nothing is hard-coded to a specific deployment. The server reads plain
# environment variables, so `go run ./cmd/server` works without this file —
# `make run` loads it automatically when present.
#
#   cp .env.example .env


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Environment name, surfaced in logs to separate deployments.
APP_ENV=development

# Address the HTTP server binds to. Use 0.0.0.0 in a container.
HTTP_ADDR=:8080

# Server timeouts. The write timeout must comfortably exceed the longest
# synchronous request; generation is asynchronous, so it does not apply here.
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths resolve from the working directory.
DATABASE_PATH=./data/app.db

# SQLite tolerates a single writer, so the pool is deliberately minimal.
DATABASE_MAX_OPEN_CONNS=1
DATABASE_MAX_IDLE_CONNS=1
DATABASE_CONN_MAX_LIFETIME=1h

# Directory for uploaded resumes (PDF only).
UPLOAD_DIR=./data/uploads

# Directory for generated cover letter PDFs.
PDF_DIR=./data/pdfs

# Largest accepted resume upload, in bytes. 10 MiB by default.
MAX_UPLOAD_SIZE=10485760


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Browser origins permitted to call this API, comma-separated. The frontend is
# served separately (Vite on :5173), so without a grant here the browser refuses
# to hand any response body to its JavaScript.
#
# Replace these with your deployed frontend origin in production. A single "*"
# allows any origin, but see CORS_ALLOW_CREDENTIALS below.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Send cookies and Authorization headers cross-origin. Cannot be combined with a
# wildcard origin — the server refuses to start on that combination, because a
# browser discards the response rather than reporting a useful error.
CORS_ALLOW_CREDENTIALS=false

# How long a browser may cache a preflight result, in seconds.
CORS_MAX_AGE_SECONDS=600


# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# Provider identifier. Only "gemini" is implemented; the AIProvider interface
# exists so another backend (e.g. Ollama) can be added without touching the
# business logic.
AI_PROVIDER=gemini

# REQUIRED when AI_PROVIDER=gemini. Never commit a real key.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for all five pipeline stages.
GEMINI_MODEL=gemini-2.5-flash

# Per-call model timeout and retry budget. Retries apply only to transient
# failures (429, 5xx, transport errors); safety blocks and 4xx are not retried.
AI_TIMEOUT=60s
AI_MAX_RETRIES=2

# Sampling defaults. Individual stages may override the temperature.
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=8192


# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------

# Number of concurrent generation tasks. Each one is a full AI pipeline, so
# this is the main lever on provider load.
WORKER_COUNT=2

# Additional tasks allowed to wait for a free worker. When the queue is full
# the API answers 503 rather than buffering work indefinitely.
WORKER_QUEUE_SIZE=32


# ---------------------------------------------------------------------------
# Job description fetching
# ---------------------------------------------------------------------------

# Outbound timeout when fetching a job posting by URL.
JOB_FETCH_TIMEOUT=15s

# Redirects followed per fetch; each hop is re-validated against the SSRF guard.
JOB_FETCH_MAX_REDIRECTS=5

# Largest HTML page accepted, in bytes.
JOB_FETCH_MAX_HTML_BYTES=4194304

# User agent sent to job boards. Some sites serve a stripped page to unknown
# agents, so set something identifiable.
JOB_FETCH_USER_AGENT=CoverLetterGenerator/1.0 (+local development)

# Longest accepted pasted job description, in runes. Applies to
# job_description only; a fetched page is bounded by JOB_FETCH_MAX_HTML_BYTES.
JOB_MAX_DESCRIPTION_RUNES=20000

# DANGEROUS. Blocks requests to loopback, private, link-local and other
# non-public addresses. Leave false outside of tests, which need it to reach
# an httptest server on 127.0.0.1. Setting this to true in production disables
# the primary SSRF defence.
JOB_FETCH_ALLOW_PRIVATE_NETWORKS=false


# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------

# Wall-clock budget for one end-to-end generation, covering job resolution,
# resume parsing, the AI pipeline and PDF rendering.
GENERATION_TIMEOUT=5m

# How many times a letter may be regenerated when validation rejects it.
# The loop is bounded so a failing model cannot spin.
GENERATION_MAX_ATTEMPTS=2


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# debug, info, warn or error.
LOG_LEVEL=info

# text for local development, json for log aggregation.
LOG_FORMAT=text